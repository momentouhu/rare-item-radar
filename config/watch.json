  "poll": {
    "_comment": "楽天APIは無料版で1日5,000リクエストが上限。毎分叩けるのは実質3クエリまでなので優先度で階層化する。pollOffset で監視ごとに実行分をずらし、1分あたりの負荷を平すこと。npm run budget で検算できる。",
    "rakutenDailyQuota": 5000,
    "tiers": {
      "realtime": {
        "everyMinutes": 1,
        "offset": 0
      },
      "fast": {
        "everyMinutes": 10,
        "offset": 3
      },
      "normal": {
        "everyMinutes": 60,
        "offset": 7
      }
    }
  },
