---
import { url } from '../lib/site';
interface Props {
  exclude?: string;
  title?: string;
}
const { exclude, title = 'ほかの計算ツール' } = Astro.props;
const tools = [
  { key: 'tedori', icon: '💴', name: '手取り計算', desc: '年収・月給から手取りを最新の税率で計算', path: '/tedori/' },
  { key: 'age', icon: '🎂', name: '年齢早見表', desc: '生まれ年から今の年齢・干支・学年がわかる', path: '/age/' },
  { key: 'wareki', icon: '📅', name: '和暦西暦変換', desc: '昭和・平成・令和を西暦に一発変換', path: '/wareki/' },
  { key: 'loan', icon: '🏠', name: '住宅ローン返済額', desc: '借入額・金利・期間から月々の返済額を試算', path: '/loan/' },
].filter((t) => t.key !== exclude);
---

<section>
  <h2>{title}</h2>
  <ul class="tool-cards">
    {
      tools.map((t) => (
        <li>
          <a class="tool-card" href={url(t.path)}>
            <div class="icon" aria-hidden="true">{t.icon}</div>
            <h3>{t.name}</h3>
            <p>{t.desc}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
