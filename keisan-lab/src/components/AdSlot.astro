---
// AdSense 用の広告枠。PUBLIC_ADSENSE_CLIENT と slot が設定されているときだけ描画する。
import { ADSENSE_CLIENT } from '../lib/site';
interface Props {
  slot?: string;
}
const { slot = import.meta.env.PUBLIC_ADSENSE_SLOT ?? '' } = Astro.props;
---

{
  ADSENSE_CLIENT && slot ? (
    <div class="ad-slot">
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script set:html="(adsbygoogle=window.adsbygoogle||[]).push({});" />
    </div>
  ) : null
}
