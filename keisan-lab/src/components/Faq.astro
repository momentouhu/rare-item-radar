---
// FAQ セクション。FAQPage の JSON-LD も同時に出力する。
interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'よくある質問' } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---

<section class="faq">
  <h2>{title}</h2>
  {
    items.map((it) => (
      <details>
        <summary>{it.q}</summary>
        <p set:html={it.a} />
      </details>
    ))
  }
</section>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
