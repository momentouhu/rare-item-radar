---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCards from '../../../components/ToolCards.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { url, TAX_YEAR_LABEL } from '../../../lib/site';
import { calcTedori } from '../../../lib/tax';
import { NENSHU_MAN } from '../../../lib/ranges';
import { yen } from '../../../lib/format';

const title = `年収別 手取り早見表【${TAX_YEAR_LABEL}】100万〜5000万円の手取り額一覧`;
const description = `年収100万円から5000万円まで、額面年収ごとの手取り額・月々の手取り・手取り率を一覧表にまとめました。${TAX_YEAR_LABEL}の社会保険料率と税制改正を反映した最新版です。`;

const rows = NENSHU_MAN.map((m) => {
  const r = calcTedori({ annualIncome: m * 10000 });
  return { m, r };
});
---

<BaseLayout
  title={title}
  description={description}
  path="/tedori/nenshu/"
  section="tedori"
  crumbs={[
    { name: '手取り計算', path: '/tedori/' },
    { name: '年収別 手取り早見表', path: '/tedori/nenshu/' },
  ]}
>
  <h1>年収別 手取り早見表【{TAX_YEAR_LABEL}】</h1>
  <p class="lead">
    額面年収ごとの手取り額を一覧にしました。独身・扶養なし・賞与なし・協会けんぽ（東京都）の会社員を想定した概算です。年収をクリックすると、内訳や賞与ありの場合、40歳以上の場合などの詳細ページに移動します。
  </p>
  <p>
    <a class="btn" href={url('/tedori/')}>自分の年収で計算する</a>
  </p>

  <AdSlot />

  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>額面年収</th><th>年間手取り</th><th>月々の手取り</th><th>社会保険料</th><th>所得税＋住民税</th><th>手取り率</th></tr>
      </thead>
      <tbody>
        {rows.map(({ m, r }) => (
          <tr>
            <td><a href={url(`/tedori/nenshu/${m}/`)}>{m.toLocaleString('ja-JP')}万円</a></td>
            <td>{yen(r.netAnnual)}円</td>
            <td>{yen(r.netMonthly)}円</td>
            <td>{yen(r.socialTotal)}円</td>
            <td>{yen(r.taxTotal)}円</td>
            <td>{(r.netRatio * 100).toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">※ 月々の手取りは年間の手取りを12で割った額。実際は住民税の徴収時期（6月〜翌5月）や所得税の年末調整で月ごとに変動します。</p>

  <h2>年収が上がるほど手取り率が下がる理由</h2>
  <p>
    年収300万円では手取り率が約80%ですが、年収1000万円では約73%、2000万円では65%程度まで下がります。所得税が5%から45%までの累進課税であること、給与所得控除が年収850万円で頭打ち（195万円）になることが主な理由です。一方、厚生年金の標準報酬月額には上限（65万円）があるため、月給65万円を超えると年金保険料はそれ以上増えません。
  </p>

  <ToolCards exclude="tedori" />
</BaseLayout>
