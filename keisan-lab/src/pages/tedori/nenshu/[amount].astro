---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TedoriBreakdown from '../../../components/TedoriBreakdown.astro';
import Faq from '../../../components/Faq.astro';
import ToolCards from '../../../components/ToolCards.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { url, TAX_YEAR_LABEL, BASE_YEAR } from '../../../lib/site';
import { calcTedori } from '../../../lib/tax';
import { NENSHU_MAN, neighbors } from '../../../lib/ranges';
import { yen, man } from '../../../lib/format';
import { monthlyPayment } from '../../../lib/loan';

export function getStaticPaths() {
  return NENSHU_MAN.map((m) => ({ params: { amount: String(m) }, props: { m } }));
}

const { m } = Astro.props as { m: number };
const annual = m * 10000;
const idx = NENSHU_MAN.indexOf(m);
const prev = idx > 0 ? NENSHU_MAN[idx - 1] : null;
const next = idx < NENSHU_MAN.length - 1 ? NENSHU_MAN[idx + 1] : null;

const base = calcTedori({ annualIncome: annual });
const over40 = calcTedori({ annualIncome: annual, over40: true });
// 賞与あり: 年2回・合計で月給4か月分（年収 = 月給 × 16）
const withBonus = calcTedori({ annualIncome: annual, bonusCount: 2, bonusTotal: Math.round((annual * 4) / 16) });

const netMan = Math.round(base.netAnnual / 10000);
const label = `${m.toLocaleString('ja-JP')}万円`;
const title = `年収${label}の手取りは約${netMan}万円｜月々${yen(base.netMonthly)}円【${BASE_YEAR}年最新】`;
const description = `年収${label}（額面）の手取りは年間約${netMan}万円、月々約${yen(base.netMonthly)}円です（手取り率${(base.netRatio * 100).toFixed(1)}%）。${TAX_YEAR_LABEL}の最新料率で社会保険料・所得税・住民税の内訳、賞与ありの場合、40歳以上の場合、家賃や住宅ローンの目安まで解説します。`;

const nearby = neighbors(NENSHU_MAN, idx, 5).map((v) => ({ v, r: calcTedori({ annualIncome: v * 10000 }) }));
const rentGuide = Math.round((base.netMonthly * 0.3) / 1000) * 1000;
const loanGuide = [5, 6, 7].map((k) => ({ k, principal: annual * k, monthly: monthlyPayment(annual * k, 0.01, 35) }));
const loanLinkMan = Math.round((annual * 6) / 1_000_000) * 100; // 100万単位に丸め

const faq = [
  {
    q: `年収${label}の月々の手取りはいくらですか？`,
    a: `賞与なしの場合、月々の手取りは約${yen(base.netMonthly)}円です。賞与が年2回（合計4か月分）ある場合は、月々約${yen(withBonus.netMonthly)}円、賞与1回あたり約${yen(withBonus.netBonusEach)}円になります。`,
  },
  {
    q: `年収${label}で引かれる税金と社会保険料の合計は？`,
    a: `年間で社会保険料が約${yen(base.socialTotal)}円、所得税が約${yen(base.incomeTax)}円、住民税が約${yen(base.residentTax)}円、合計約${yen(base.deductionTotal)}円が差し引かれます（手取り率${(base.netRatio * 100).toFixed(1)}%）。`,
  },
  {
    q: `年収${label}で40歳以上の場合の手取りは？`,
    a: `40〜64歳は介護保険料（本人負担 年約${yen(over40.care)}円）が加わるため、年間の手取りは約${yen(over40.netAnnual)}円、月々約${yen(over40.netMonthly)}円になります。`,
  },
  {
    q: `年収${label}の家賃の目安は？`,
    a: `一般に家賃は手取り月収の25〜30%以内が目安とされます。年収${label}なら月${yen(Math.round((base.netMonthly * 0.25) / 1000) * 1000)}〜${yen(rentGuide)}円程度が無理のない範囲です。`,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: `${BASE_YEAR}-09-01`,
  dateModified: `${BASE_YEAR}-09-15`,
  author: { '@type': 'Organization', name: 'けいさんラボ' },
};
---

<BaseLayout
  title={title}
  description={description}
  path={`/tedori/nenshu/${m}/`}
  section="tedori"
  type="article"
  jsonLd={jsonLd}
  crumbs={[
    { name: '手取り計算', path: '/tedori/' },
    { name: '年収別 手取り早見表', path: '/tedori/nenshu/' },
    { name: `年収${label}`, path: `/tedori/nenshu/${m}/` },
  ]}
>
  <h1>年収{label}の手取りは約{netMan}万円【{TAX_YEAR_LABEL}】</h1>
  <p class="lead">
    額面年収{label}の会社員（独身・扶養なし・賞与なし）の手取りは、<strong>年間約{man(base.netAnnual)}、月々約{yen(base.netMonthly)}円</strong>です。{TAX_YEAR_LABEL}の社会保険料率と所得税の改正（基礎控除の引き上げ）を反映して計算しています。
  </p>

  <div class="hero-result">
    <div class="label">年収{label}の年間手取り（概算）</div>
    <div class="value">{yen(base.netAnnual)}<small>円</small></div>
    <div class="sub">
      <span>月々の手取り <b>{yen(base.netMonthly)}</b>円</span>
      <span>手取り率 <b>{(base.netRatio * 100).toFixed(1)}</b>%</span>
      <span>控除合計 <b>{yen(base.deductionTotal)}</b>円/年</span>
    </div>
  </div>

  <div class="toc">
    <b>目次</b>
    <ol>
      <li><a href="#breakdown">手取りの内訳</a></li>
      <li><a href="#bonus">賞与ありの場合</a></li>
      <li><a href="#over40">40歳以上の場合</a></li>
      <li><a href="#nearby">近い年収との比較</a></li>
      <li><a href="#life">生活水準の目安（家賃・住宅ローン）</a></li>
      <li><a href="#faq">よくある質問</a></li>
    </ol>
  </div>

  <h2 id="breakdown">年収{label}の手取りの内訳</h2>
  <p>年収{label}から差し引かれる社会保険料と税金の内訳は次のとおりです。</p>
  <TedoriBreakdown r={base} />
  <p class="table-note">※ 協会けんぽ（東京都）・厚生年金・雇用保険（一般の事業）加入、扶養なし、各種控除は基礎控除・給与所得控除・社会保険料控除のみで計算。</p>

  <AdSlot />

  <h2 id="bonus">賞与ありの場合（年2回・合計4か月分）</h2>
  <p>
    年収{label}のうち賞与が年2回・合計で月給4か月分（年収の25%）ある場合、月給は額面約{yen(withBonus.monthlySalary)}円、賞与は1回あたり額面約{yen(withBonus.bonusEach)}円になります。
  </p>
  <div class="stat-grid">
    <div class="stat"><div class="k">月々の手取り</div><div class="v">{yen(withBonus.netMonthly)}円</div></div>
    <div class="stat"><div class="k">賞与1回の手取り</div><div class="v">{yen(withBonus.netBonusEach)}円</div></div>
    <div class="stat"><div class="k">年間の手取り</div><div class="v">{yen(withBonus.netAnnual)}円</div></div>
  </div>
  <p>
    賞与にも社会保険料と所得税はかかりますが、年間の手取り合計は賞与なしの場合とほぼ同じです（標準報酬月額の等級の違いで数千円〜数万円の差が出ることがあります）。
  </p>

  <h2 id="over40">40歳以上の場合（介護保険料あり）</h2>
  <p>
    40歳から64歳までは健康保険料に加えて介護保険料（本人負担分 年約{yen(over40.care)}円）が徴収されます。年収{label}・40歳以上の手取りは<strong>年間約{yen(over40.netAnnual)}円、月々約{yen(over40.netMonthly)}円</strong>です。
  </p>

  <h2 id="nearby">近い年収との手取り比較</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>年収</th><th>年間手取り</th><th>月々の手取り</th><th>手取り率</th></tr></thead>
      <tbody>
        {nearby.map(({ v, r }) => (
          <tr class={v === m ? 'hl' : ''}>
            <td>{v === m ? `${v}万円` : <a href={url(`/tedori/nenshu/${v}/`)}>{v.toLocaleString('ja-JP')}万円</a>}</td>
            <td>{yen(r.netAnnual)}円</td>
            <td>{yen(r.netMonthly)}円</td>
            <td>{(r.netRatio * 100).toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="prev-next">
    {prev ? <a href={url(`/tedori/nenshu/${prev}/`)}>‹ 年収{prev}万円の手取り</a> : <span />}
    {next ? <a href={url(`/tedori/nenshu/${next}/`)}>年収{next}万円の手取り ›</a> : <span />}
  </div>

  <h2 id="life">年収{label}の生活水準の目安</h2>
  <h3>家賃の目安</h3>
  <p>
    家賃は手取り月収の25〜30%以内が無理のない目安とされています。年収{label}（手取り月約{yen(base.netMonthly)}円）なら、<strong>月{yen(rentGuide)}円前後</strong>が上限の目安です。
  </p>
  <h3>住宅ローンの借入目安</h3>
  <p>
    住宅ローンの借入額は年収の5〜7倍が一つの目安です。年収{label}の場合の借入額と、金利1.0%・35年返済での月々の返済額は次のとおりです。
  </p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>年収倍率</th><th>借入額</th><th>月々の返済額</th><th>手取り月収に対する割合</th></tr></thead>
      <tbody>
        {loanGuide.map((g) => (
          <tr>
            <td>{g.k}倍</td>
            <td>{man(g.principal)}</td>
            <td>{yen(g.monthly)}円</td>
            <td>{((g.monthly / base.netMonthly) * 100).toFixed(0)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p>
    <a href={url(`/loan/${loanLinkMan}/`)}>借入額{loanLinkMan.toLocaleString('ja-JP')}万円の返済シミュレーションを見る ›</a>
  </p>

  <Faq items={faq} />

  <h2>ほかの年収の手取りを見る</h2>
  <ul class="link-grid">
    {[200, 250, 300, 350, 400, 450, 500, 550, 600, 650, 700, 800, 900, 1000, 1200, 1500].map((v) => (
      <li><a href={url(`/tedori/nenshu/${v}/`)} class={v === m ? 'current' : ''}>年収{v}万円</a></li>
    ))}
  </ul>
  <p><a href={url('/tedori/nenshu/')}>年収別 手取り早見表（100万〜5000万円）›</a>　<a href={url(`/tedori/?nenshu=${m}`)}>自分の条件で細かく計算する ›</a></p>

  <ToolCards exclude="tedori" />
</BaseLayout>
