---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCards from '../../../components/ToolCards.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { url, TAX_YEAR_LABEL } from '../../../lib/site';
import { calcTedoriFromMonthly } from '../../../lib/tax';
import { GEKKYU_MAN } from '../../../lib/ranges';
import { yen } from '../../../lib/format';

const title = `月給別 手取り早見表【${TAX_YEAR_LABEL}】月給10万〜100万円の手取り額一覧`;
const description = `月給（額面）10万円から100万円まで、1万円刻みで月々の手取り額と社会保険料・税金の内訳を一覧にしました。${TAX_YEAR_LABEL}の最新料率で計算した早見表です。`;
const rows = GEKKYU_MAN.map((m) => ({ m, r: calcTedoriFromMonthly(m * 10000) }));
---

<BaseLayout
  title={title}
  description={description}
  path="/tedori/gekkyu/"
  section="tedori"
  crumbs={[
    { name: '手取り計算', path: '/tedori/' },
    { name: '月給別 手取り早見表', path: '/tedori/gekkyu/' },
  ]}
>
  <h1>月給別 手取り早見表【{TAX_YEAR_LABEL}】</h1>
  <p class="lead">
    額面の月給ごとに、社会保険料と税金を引いた月々の手取り額を一覧にしました。賞与なし・独身・扶養なし・協会けんぽ（東京都）の会社員を想定した概算です。
  </p>
  <p><a class="btn" href={url('/tedori/')}>自分の月給で計算する</a></p>

  <AdSlot />

  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>額面月給</th><th>月々の手取り</th><th>社会保険料/月</th><th>所得税/月</th><th>住民税/月</th><th>手取り率</th></tr>
      </thead>
      <tbody>
        {rows.map(({ m, r }) => (
          <tr>
            <td><a href={url(`/tedori/gekkyu/${m}/`)}>{m}万円</a></td>
            <td>{yen(r.netMonthly)}円</td>
            <td>{yen(r.socialTotal / 12)}円</td>
            <td>{yen(r.incomeTax / 12)}円</td>
            <td>{yen(r.residentTax / 12)}円</td>
            <td>{(r.netRatio * 100).toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">※ 所得税・住民税は年額を12で割った額。実際の給与明細では所得税は源泉徴収税額表、住民税は前年所得ベースで決まるため月ごとに差があります。</p>

  <h2>月給から手取りを知るときのポイント</h2>
  <ul>
    <li><strong>社会保険料は「標準報酬月額」で決まる</strong>：4〜6月の給与の平均をもとに等級が決まり、原則1年間固定です。残業代が多い月でも保険料は変わりません。</li>
    <li><strong>入社1年目は住民税がかからない</strong>：住民税は前年の所得に対して翌年6月から徴収されるため、新卒1年目の手取りはこの表より住民税分だけ多くなります。</li>
    <li><strong>賞与がある場合</strong>：賞与からも社会保険料と所得税が引かれます。年収ベースで確認したい場合は<a href={url('/tedori/nenshu/')}>年収別の早見表</a>をご覧ください。</li>
  </ul>

  <ToolCards exclude="tedori" />
</BaseLayout>
