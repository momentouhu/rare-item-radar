---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCards from '../../../components/ToolCards.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Faq from '../../../components/Faq.astro';
import { url, BASE_YEAR } from '../../../lib/site';
import { seirekiYears } from '../../../lib/ranges';
import { warekiOfYear, warekiLabel, eraSlug, eto, ageRange, kazoedoshi } from '../../../lib/wareki';

export function getStaticPaths() {
  return seirekiYears(BASE_YEAR).map((y) => ({ params: { year: String(y) }, props: { y } }));
}

const { y } = Astro.props as { y: number };
const years = seirekiYears(BASE_YEAR);
const idx = years.indexOf(y);
const prev = idx > 0 ? years[idx - 1] : null;
const next = idx < years.length - 1 ? years[idx + 1] : null;
const ws = warekiOfYear(y);
const label = warekiLabel(y);
const e = eto(y);
const age = ageRange(y, BASE_YEAR);
const isPast = y <= BASE_YEAR;
const nearby = years.slice(Math.max(0, idx - 5), idx + 6);

const title = `${y}年は${label}｜西暦${y}年の和暦・干支${isPast ? `・${BASE_YEAR}年の年齢` : ''}`;
const description = `西暦${y}年は和暦で${label}です。${ws.length > 1 ? `${ws[0].era.name}から${ws[1].era.name}へ改元された年です。` : ''}干支は${e.junishi}（${e.animal}）年。${isPast ? `${y}年生まれの人は${BASE_YEAR}年に満${age.after}歳（数え年${kazoedoshi(y, BASE_YEAR)}歳）になります。` : ''}`;
const faq = [
  { q: `${y}年は和暦で何年？`, a: `西暦${y}年は${label}です。${ws.map((w) => `${w.era.name}の年は「西暦 − ${w.era.start.y - 1}」で求められます。`).join('')}` },
  { q: `${y}年の干支は？`, a: `${y}年の干支は${e.junishi}（${e.animal}）年、十干十二支では${e.kanshi}（${e.kanshiYomi}）です。` },
];
---

<BaseLayout
  title={title}
  description={description}
  path={`/wareki/seireki/${y}/`}
  section="wareki"
  type="article"
  crumbs={[
    { name: '和暦西暦変換表', path: '/wareki/' },
    { name: `${y}年`, path: `/wareki/seireki/${y}/` },
  ]}
>
  <h1>{y}年は和暦で{label}</h1>
  <p class="lead">西暦{y}年は<strong>{label}</strong>です。{ws.length > 1 && `${y}年は${ws[0].era.name}から${ws[1].era.name}への改元があった年で、${ws[0].era.end!.m}月${ws[0].era.end!.d}日までが${ws[0].label}、${ws[1].era.start.m}月${ws[1].era.start.d}日からが${ws[1].label}です。`}干支は{e.junishi}（{e.animal}）年。</p>

  <div class="hero-result">
    <div class="label">西暦{y}年</div>
    <div class="value" style="font-size:clamp(1.6rem,5vw,2.4rem)">{label}</div>
    <div class="sub">
      <span>干支 <b>{e.junishi}（{e.animal}）</b></span>
      <span>十干十二支 <b>{e.kanshi}</b></span>
      {isPast && <span>{BASE_YEAR}年の年齢 <b>{age.after}</b>歳</span>}
    </div>
  </div>

  {isPast && y >= 1920 && <p><a class="btn btn-ghost" href={url(`/age/${y}/`)}>{y}年生まれの年齢・学年・厄年を見る</a></p>}

  <AdSlot />

  <h2>前後の年の和暦</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>西暦</th><th>和暦</th><th>干支</th><th>{BASE_YEAR}年の年齢</th></tr></thead>
      <tbody>
        {nearby.map((v) => (
          <tr class={v === y ? 'hl' : ''}>
            <td>{v === y ? `${v}年` : <a href={url(`/wareki/seireki/${v}/`)}>{v}年</a>}</td>
            <td style="text-align:left">{warekiOfYear(v).map((w, i) => <>{i > 0 && ' / '}<a href={url(`/wareki/${eraSlug(w.era)}/${w.n}/`)}>{w.label}</a></>)}</td>
            <td>{eto(v).junishi}</td>
            <td>{v <= BASE_YEAR ? `${BASE_YEAR - v}歳` : '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="prev-next">
    {prev ? <a href={url(`/wareki/seireki/${prev}/`)}>‹ {prev}年</a> : <span />}
    {next ? <a href={url(`/wareki/seireki/${next}/`)}>{next}年 ›</a> : <span />}
  </div>

  <Faq items={faq} />
  <p><a href={url('/wareki/')}>和暦西暦変換表（明治〜令和）›</a></p>
  <ToolCards exclude="wareki" />
</BaseLayout>
