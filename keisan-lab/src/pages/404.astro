---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCards from '../components/ToolCards.astro';
import { url } from '../lib/site';
---

<BaseLayout title="ページが見つかりません" path="/404/" noindex={true}>
  <h1>ページが見つかりません</h1>
  <p>お探しのページは移動または削除された可能性があります。<a href={url('/')}>トップページ</a>から目的のツールをお探しください。</p>
  <ToolCards title="計算ツール一覧" />
</BaseLayout>
