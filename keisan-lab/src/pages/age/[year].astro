---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCards from '../../components/ToolCards.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import { url, BASE_YEAR } from '../../lib/site';
import { birthYears } from '../../lib/ranges';
import {
  warekiLabel, warekiOfYear, eto, ageRange, kazoedoshi, schoolYears, yakudoshiInfo, YAKUDOSHI, chojuYears, eraSlug,
} from '../../lib/wareki';

export function getStaticPaths() {
  return birthYears(BASE_YEAR).map((y) => ({ params: { year: String(y) }, props: { y } }));
}

const { y } = Astro.props as { y: number };
const years = birthYears(BASE_YEAR);
const idx = years.indexOf(y);
const prev = idx > 0 ? years[idx - 1] : null;
const next = idx < years.length - 1 ? years[idx + 1] : null;

const age = ageRange(y, BASE_YEAR);
const kazoe = kazoedoshi(y, BASE_YEAR);
const wareki = warekiLabel(y);
const warekis = warekiOfYear(y);
const e = eto(y);
const late = schoolYears(y, false);
const early = schoolYears(y, true);
const yaku = yakudoshiInfo(y, BASE_YEAR);
const choju = chojuYears(y);
const nextYaku = (ages: readonly number[]) => ages.map((a) => ({ a, year: y + a - 1 })).filter((v) => v.year >= BASE_YEAR);
const ageTable = Array.from({ length: 11 }, (_, i) => BASE_YEAR + i).map((yy) => ({ yy, age: yy - y, wareki: warekiLabel(yy) }));

const title = `${y}年（${wareki}）生まれは今何歳？【${BASE_YEAR}年】満${age.after}歳・干支は${e.junishi}`;
const description = `${y}年（${wareki}）生まれの人は${BASE_YEAR}年に満${age.after}歳になります（誕生日前は${Math.max(age.before, 0)}歳、数え年${kazoe}歳）。干支は${e.junishi}（${e.animal}）年。小学校・中学校・高校・大学の入学卒業年、厄年、還暦などの長寿祝いの年もまとめました。`;

const faq = [
  { q: `${y}年生まれは${BASE_YEAR}年で何歳？`, a: `${y}年生まれの人は、${BASE_YEAR}年の誕生日を迎えると満${age.after}歳、誕生日前は${Math.max(age.before, 0)}歳です。数え年では${kazoe}歳になります。` },
  { q: `${y}年は和暦で何年？`, a: `${y}年は和暦で${wareki}です。` },
  { q: `${y}年生まれの干支は？`, a: `${y}年生まれの干支は${e.junishi}（${e.animal}）年、十干十二支では${e.kanshi}（${e.kanshiYomi}）です。` },
  { q: `${y}年生まれはいつ小学校に入学した？`, a: `4月2日〜12月31日生まれは${late.elementaryIn}年4月、1月1日〜4月1日の早生まれは${early.elementaryIn}年4月に小学校へ入学しています。` },
];
---

<BaseLayout
  title={title}
  description={description}
  path={`/age/${y}/`}
  section="age"
  type="article"
  crumbs={[
    { name: '年齢早見表', path: '/age/' },
    { name: `${y}年生まれ`, path: `/age/${y}/` },
  ]}
>
  <h1>{y}年（{wareki}）生まれは今何歳？</h1>
  <p class="lead">
    {y}年（{wareki}）生まれの人は、<strong>{BASE_YEAR}年の誕生日を迎えると満{age.after}歳</strong>、誕生日前は{Math.max(age.before, 0)}歳です。干支は{e.junishi}（{e.animal}）年。
  </p>

  <div class="hero-result" data-birth-year={y}>
    <div class="label"><span id="age-label">{BASE_YEAR}年の満年齢</span></div>
    <div class="value"><span id="age-main">{age.after}</span><small>歳</small><span id="age-alt" style="font-size:.45em;color:var(--text-2);margin-left:.6em">（誕生日前は{Math.max(age.before, 0)}歳）</span></div>
    <div class="sub">
      <span>数え年 <b id="age-kazoe">{kazoe}</b>歳</span>
      <span>和暦 <b>{wareki}</b></span>
      <span>干支 <b>{e.junishi}（{e.animal}）</b></span>
      <span>十干十二支 <b>{e.kanshi}</b></span>
    </div>
    <p class="updated" id="age-today" style="margin:.5rem 0 0">誕生日を入れると今日時点の正確な年齢を表示します：
      <select id="bm" aria-label="月">{Array.from({ length: 12 }, (_, i) => <option value={i + 1}>{i + 1}月</option>)}</select>
      <select id="bd" aria-label="日">{Array.from({ length: 31 }, (_, i) => <option value={i + 1}>{i + 1}日</option>)}</select>
    </p>
  </div>

  <div class="toc">
    <b>目次</b>
    <ol>
      <li><a href="#school">入学・卒業年（早生まれ／遅生まれ）</a></li>
      <li><a href="#yaku">厄年</a></li>
      <li><a href="#choju">還暦・古希などの長寿祝い</a></li>
      <li><a href="#future">今後の年齢の推移</a></li>
      <li><a href="#faq">よくある質問</a></li>
    </ol>
  </div>

  <h2 id="school">{y}年生まれの入学・卒業年</h2>
  <p>4月2日〜12月31日生まれと、1月1日〜4月1日生まれ（早生まれ）で学年が変わります。留年・浪人がない場合の年です。</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>学校</th><th>4/2〜12/31生まれ 入学</th><th>卒業</th><th>1/1〜4/1生まれ（早生まれ）入学</th><th>卒業</th></tr></thead>
      <tbody>
        <tr><td>小学校</td><td>{late.elementaryIn}年4月</td><td>{late.elementaryOut}年3月</td><td>{early.elementaryIn}年4月</td><td>{early.elementaryOut}年3月</td></tr>
        <tr><td>中学校</td><td>{late.juniorIn}年4月</td><td>{late.juniorOut}年3月</td><td>{early.juniorIn}年4月</td><td>{early.juniorOut}年3月</td></tr>
        <tr><td>高校</td><td>{late.highIn}年4月</td><td>{late.highOut}年3月</td><td>{early.highIn}年4月</td><td>{early.highOut}年3月</td></tr>
        <tr><td>大学（4年制）</td><td>{late.universityIn}年4月</td><td>{late.universityOut}年3月</td><td>{early.universityIn}年4月</td><td>{early.universityOut}年3月</td></tr>
        <tr><td>成人式（20歳の年度）</td><td colspan="2">{late.seijin}年1月</td><td colspan="2">{early.seijin}年1月</td></tr>
      </tbody>
    </table>
  </div>

  <AdSlot />

  <h2 id="yaku">{y}年生まれの厄年</h2>
  <p>
    厄年は数え年で数えます。{y}年生まれの{BASE_YEAR}年の数え年は{kazoe}歳で、
    男性は{yaku.male ? <strong>{yaku.male.kind}（{yaku.male.age}歳）</strong> : '厄年ではありません'}、
    女性は{yaku.female ? <strong>{yaku.female.kind}（{yaku.female.age}歳）</strong> : '厄年ではありません'}。
  </p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>性別</th><th>本厄（数え年）</th><th>本厄になる年</th></tr></thead>
      <tbody>
        <tr><td>男性</td><td>{YAKUDOSHI.male.main.join('・')}歳</td><td>{YAKUDOSHI.male.main.map((a) => `${a}歳: ${y + a - 1}年`).join(' / ')}</td></tr>
        <tr><td>女性</td><td>{YAKUDOSHI.female.main.join('・')}歳</td><td>{YAKUDOSHI.female.main.map((a) => `${a}歳: ${y + a - 1}年`).join(' / ')}</td></tr>
      </tbody>
    </table>
  </div>
  <p class="table-note">※ 本厄の前年が前厄、翌年が後厄です。{nextYaku(YAKUDOSHI.male.main).length > 0 ? `男性の次の本厄は${nextYaku(YAKUDOSHI.male.main)[0].year}年（${nextYaku(YAKUDOSHI.male.main)[0].a}歳）。` : ''}{nextYaku(YAKUDOSHI.female.main).length > 0 ? `女性の次の本厄は${nextYaku(YAKUDOSHI.female.main)[0].year}年（${nextYaku(YAKUDOSHI.female.main)[0].a}歳）。` : ''}</p>

  <h2 id="choju">{y}年生まれの長寿祝い（還暦・古希・喜寿…）</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>お祝い</th><th>年齢（満）</th><th>迎える年</th></tr></thead>
      <tbody>
        {choju.map((c) => (
          <tr class={c.year === BASE_YEAR ? 'hl' : ''}>
            <td>{c.name}（{c.yomi}）</td>
            <td>{c.age}歳</td>
            <td>{c.year}年（{warekiLabel(c.year)}）{c.year < BASE_YEAR ? ' 済' : c.year === BASE_YEAR ? ' 今年' : ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">※ 還暦は満60歳（数え61歳）、それ以外は一般に数え年で祝いますが、近年は満年齢で祝うことも多くなっています。</p>

  <h2 id="future">{y}年生まれの今後の年齢</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>西暦</th><th>和暦</th><th>満年齢（誕生日後）</th><th>数え年</th></tr></thead>
      <tbody>
        {ageTable.map((row) => (
          <tr class={row.yy === BASE_YEAR ? 'hl' : ''}>
            <td>{row.yy}年</td><td style="text-align:left">{row.wareki}</td><td>{row.age}歳</td><td>{row.age + 1}歳</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="prev-next">
    {prev ? <a href={url(`/age/${prev}/`)}>‹ {prev}年生まれ</a> : <span />}
    {next ? <a href={url(`/age/${next}/`)}>{next}年生まれ ›</a> : <span />}
  </div>

  <Faq items={faq} />

  <h2>関連ページ</h2>
  <ul>
    {warekis.map((w) => (
      <li><a href={url(`/wareki/${eraSlug(w.era)}/${w.n}/`)}>{w.label}は西暦何年？</a></li>
    ))}
    <li><a href={url(`/wareki/seireki/${y}/`)}>{y}年は和暦で何年？</a></li>
    <li><a href={url('/age/')}>年齢早見表【{BASE_YEAR}年版】</a></li>
    <li><a href={url('/age/eto/')}>干支早見表</a></li>
  </ul>
  <ul class="link-grid">
    {[1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020].map((v) => (
      <li><a href={url(`/age/${v}/`)}>{v}年生まれ</a></li>
    ))}
  </ul>
  <ToolCards exclude="age" />
</BaseLayout>

<script>
  // 今日の日付で年齢を補正する（静的生成は基準年ベースのため）
  const box = document.querySelector<HTMLElement>('.hero-result[data-birth-year]')!;
  const y = Number(box.dataset.birthYear);
  const bm = document.getElementById('bm') as HTMLSelectElement;
  const bd = document.getElementById('bd') as HTMLSelectElement;
  const main = document.getElementById('age-main')!;
  const alt = document.getElementById('age-alt')!;
  const label = document.getElementById('age-label')!;
  const kazoe = document.getElementById('age-kazoe')!;
  let touched = false;
  function render() {
    const t = new Date();
    const ty = t.getFullYear();
    kazoe.textContent = String(ty - y + 1);
    if (!touched) {
      main.textContent = String(ty - y);
      alt.textContent = `（誕生日前は${Math.max(ty - y - 1, 0)}歳）`;
      label.textContent = `${ty}年の満年齢`;
      return;
    }
    const m = Number(bm.value), d = Number(bd.value);
    let age = ty - y;
    if (t.getMonth() + 1 < m || (t.getMonth() + 1 === m && t.getDate() < d)) age -= 1;
    main.textContent = String(Math.max(age, 0));
    alt.textContent = `（${ty}年${t.getMonth() + 1}月${t.getDate()}日現在）`;
    label.textContent = `${y}年${m}月${d}日生まれの今日の満年齢`;
  }
  [bm, bd].forEach((el) => el.addEventListener('change', () => { touched = true; render(); }));
  render();
</script>
