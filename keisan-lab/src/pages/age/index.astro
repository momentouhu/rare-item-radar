---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCards from '../../components/ToolCards.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import { url, BASE_YEAR } from '../../lib/site';
import { birthYears } from '../../lib/ranges';
import { warekiLabel, eto, ageRange, kazoedoshi } from '../../lib/wareki';

const title = `年齢早見表【${BASE_YEAR}年版】生まれ年・和暦・干支から今の年齢が一目でわかる`;
const description = `${BASE_YEAR}年（令和8年）の年齢早見表。1920年から${BASE_YEAR}年まで、生まれ年（西暦・和暦）ごとの満年齢・数え年・干支を一覧にしました。生まれ年をクリックすると入学卒業年や厄年、長寿祝いの年もわかります。`;
const years = birthYears(BASE_YEAR).slice().reverse();
const faq = [
  { q: '満年齢と数え年の違いは？', a: '満年齢は生まれた時を0歳とし、誕生日ごとに1歳ずつ増える数え方です。数え年は生まれた時を1歳とし、毎年1月1日に全員が1歳ずつ増えます。数え年は「今年の西暦 − 生まれ年 ＋ 1」で求められ、厄年や長寿祝いに使われます。' },
  { q: '早生まれとは？', a: '1月1日から4月1日までに生まれた人を早生まれと呼びます。学年は4月2日から翌年4月1日生まれまでが同じ学年になるため、早生まれの人は前年生まれの人と同じ学年です。' },
  { q: `${BASE_YEAR}年に成人（18歳）になるのは何年生まれ？`, a: `${BASE_YEAR}年に18歳の誕生日を迎えるのは${BASE_YEAR - 18}年生まれの人です。20歳になるのは${BASE_YEAR - 20}年生まれ、還暦（60歳）は${BASE_YEAR - 60}年生まれの人です。` },
];
---

<BaseLayout title={title} description={description} path="/age/" section="age" crumbs={[{ name: '年齢早見表', path: '/age/' }]}>
  <h1>年齢早見表【{BASE_YEAR}年版】</h1>
  <p class="lead">
    生まれ年（西暦・和暦）から、{BASE_YEAR}年の満年齢・数え年・干支がすぐにわかる早見表です。「今年の誕生日を迎えた後」の年齢を基準に、迎える前の年齢も併記しています。
  </p>

  <form class="calc" id="age-form" autocomplete="off">
    <div class="calc-grid">
      <div class="field">
        <label for="by">生まれた年（西暦）</label>
        <div class="input"><input type="number" id="by" inputmode="numeric" value="1990" min="1868" max={BASE_YEAR} /><span class="unit">年</span></div>
      </div>
      <div class="field">
        <label for="bm">月</label>
        <div class="input"><input type="number" id="bm" inputmode="numeric" value="1" min="1" max="12" /><span class="unit">月</span></div>
      </div>
      <div class="field">
        <label for="bd">日</label>
        <div class="input"><input type="number" id="bd" inputmode="numeric" value="1" min="1" max="31" /><span class="unit">日</span></div>
      </div>
    </div>
    <div class="hero-result" style="margin-bottom:0">
      <div class="label">今日時点の満年齢</div>
      <div class="value"><span id="age-out">—</span><small>歳</small></div>
      <div class="sub"><span id="age-note"></span> <a id="age-link" href="#">この生まれ年の詳細ページ ›</a></div>
    </div>
  </form>

  <AdSlot />

  <h2>{BASE_YEAR}年の年齢早見表（1920年〜{BASE_YEAR}年生まれ）</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>西暦</th><th>和暦</th><th>満年齢（誕生日後）</th><th>誕生日前</th><th>数え年</th><th>干支</th></tr>
      </thead>
      <tbody>
        {years.map((y) => {
          const a = ageRange(y, BASE_YEAR);
          const e = eto(y);
          return (
            <tr>
              <td><a href={url(`/age/${y}/`)}>{y}年</a></td>
              <td style="text-align:left">{warekiLabel(y)}</td>
              <td>{a.after}歳</td>
              <td>{a.before >= 0 ? `${a.before}歳` : '—'}</td>
              <td>{kazoedoshi(y, BASE_YEAR)}歳</td>
              <td>{e.junishi}（{e.animal}）</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <Faq items={faq} />
  <p><a href={url('/age/eto/')}>干支早見表 ›</a>　<a href={url('/wareki/')}>和暦西暦変換表 ›</a></p>
  <ToolCards exclude="age" />
</BaseLayout>

<script>
  const base = (import.meta.env.BASE_URL as string).replace(/\/$/, '');
  const by = document.getElementById('by') as HTMLInputElement;
  const bm = document.getElementById('bm') as HTMLInputElement;
  const bd = document.getElementById('bd') as HTMLInputElement;
  const out = document.getElementById('age-out')!;
  const note = document.getElementById('age-note')!;
  const link = document.getElementById('age-link') as HTMLAnchorElement;
  function render() {
    const y = Number(by.value), m = Number(bm.value) || 1, d = Number(bd.value) || 1;
    if (!y || y < 1868) { out.textContent = '—'; return; }
    const t = new Date();
    let age = t.getFullYear() - y;
    const beforeBirthday = t.getMonth() + 1 < m || (t.getMonth() + 1 === m && t.getDate() < d);
    if (beforeBirthday) age -= 1;
    out.textContent = String(Math.max(age, 0));
    note.textContent = `${t.getFullYear()}年${t.getMonth() + 1}月${t.getDate()}日現在。数え年は${t.getFullYear() - y + 1}歳。`;
    link.href = `${base}/age/${y}/`;
  }
  ['input', 'change'].forEach((ev) => document.getElementById('age-form')!.addEventListener(ev, render));
  render();
</script>
