---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCards from '../../components/ToolCards.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import { url, BASE_YEAR } from '../../lib/site';
import { monthlyPayment, RATE_PRESETS, YEAR_PRESETS } from '../../lib/loan';
import { LOAN_MAN } from '../../lib/ranges';
import { yen } from '../../lib/format';

const title = `住宅ローン返済シミュレーター｜借入額・金利・期間から月々の返済額を計算【${BASE_YEAR}年】`;
const description = `借入額・金利・返済期間を入力するだけで、住宅ローンの月々の返済額・総支払額・利息総額を計算します。元利均等と元金均等の両方に対応。500万〜1億5000万円の借入額別早見表付き。`;
const popular = [2000, 2500, 3000, 3500, 4000, 4500, 5000, 6000];
const faq = [
  { q: '元利均等返済と元金均等返済の違いは？', a: '元利均等返済は毎月の返済額（元金＋利息）が一定で、返済計画が立てやすい一方、総支払額はやや多くなります。元金均等返済は毎月の元金が一定で、初回の返済額が最も多く徐々に減っていきます。総支払額は元金均等の方が少なくなります。' },
  { q: '住宅ローンの借入額の目安は？', a: '一般に年収の5〜7倍、返済負担率（年間返済額 ÷ 年収）は20〜25%以内が無理のない目安とされています。金融機関の審査上限は返済負担率30〜35%程度です。' },
  { q: '金利が0.5%上がると返済額はどれくらい変わる？', a: `借入3000万円・35年返済の場合、金利1.0%では月々${yen(monthlyPayment(30000000, 0.01, 35))}円、1.5%では${yen(monthlyPayment(30000000, 0.015, 35))}円と、月約${yen(monthlyPayment(30000000, 0.015, 35) - monthlyPayment(30000000, 0.01, 35))}円、総額では約${Math.round(((monthlyPayment(30000000, 0.015, 35) - monthlyPayment(30000000, 0.01, 35)) * 420) / 10000)}万円の差になります。` },
];
---

<BaseLayout title={title} description={description} path="/loan/" section="loan" crumbs={[{ name: '住宅ローン返済シミュレーター', path: '/loan/' }]}>
  <h1>住宅ローン返済シミュレーター</h1>
  <p class="lead">借入額・金利・返済期間から、<strong>月々の返済額・総支払額・利息総額</strong>を計算します。ボーナス払いなし・全期間同じ金利の前提です。</p>

  <form class="calc" id="loan-form" autocomplete="off">
    <div class="calc-grid">
      <div class="field">
        <label for="principal">借入額</label>
        <div class="input"><input type="number" id="principal" inputmode="numeric" value="3000" min="1" step="10" /><span class="unit">万円</span></div>
      </div>
      <div class="field">
        <label for="rate">金利（年）</label>
        <div class="input"><input type="number" id="rate" inputmode="decimal" value="1.0" min="0" max="20" step="0.01" /><span class="unit">%</span></div>
      </div>
      <div class="field">
        <label for="years">返済期間</label>
        <div class="input"><input type="number" id="years" inputmode="numeric" value="35" min="1" max="50" step="1" /><span class="unit">年</span></div>
      </div>
      <div class="field">
        <label for="income">年収（任意・返済負担率の計算用）</label>
        <div class="input"><input type="number" id="income" inputmode="numeric" value="" placeholder="500" min="0" step="10" /><span class="unit">万円</span></div>
      </div>
    </div>
  </form>

  <div class="hero-result" aria-live="polite">
    <div class="label">月々の返済額（元利均等）</div>
    <div class="value"><span id="l-monthly">—</span><small>円</small></div>
    <div class="sub">
      <span>総支払額 <b id="l-total">—</b>円</span>
      <span>利息総額 <b id="l-interest">—</b>円</span>
      <span id="l-ratio-wrap" hidden>返済負担率 <b id="l-ratio">—</b>%</span>
    </div>
  </div>
  <div class="stat-grid">
    <div class="stat"><div class="k">元金均等 初回返済額</div><div class="v"><span id="l-ep-first">—</span>円</div></div>
    <div class="stat"><div class="k">元金均等 最終回返済額</div><div class="v"><span id="l-ep-last">—</span>円</div></div>
    <div class="stat"><div class="k">元金均等 利息総額</div><div class="v"><span id="l-ep-interest">—</span>円</div></div>
  </div>

  <AdSlot />

  <h2>借入額別の返済額早見表（金利1.0%・35年）</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>借入額</th>{YEAR_PRESETS.map((y) => <th>{y}年</th>)}</tr></thead>
      <tbody>
        {LOAN_MAN.map((m) => (
          <tr>
            <td><a href={url(`/loan/${m}/`)}>{m.toLocaleString('ja-JP')}万円</a></td>
            {YEAR_PRESETS.map((y) => <td>{yen(monthlyPayment(m * 10000, 0.01, y))}円</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">※ 元利均等返済・ボーナス払いなし・金利1.0%固定の場合の月々の返済額。借入額をクリックすると金利別の詳細が見られます。</p>

  <h2>よく見られている借入額</h2>
  <ul class="link-grid">
    {popular.map((m) => <li><a href={url(`/loan/${m}/`)}>{m.toLocaleString('ja-JP')}万円</a></li>)}
  </ul>

  <h2>住宅ローンの返済額の計算式</h2>
  <p>元利均等返済の月々の返済額は次の式で求められます。</p>
  <p><code>月々の返済額 ＝ 借入額 × r × (1 + r)<sup>n</sup> ÷ ((1 + r)<sup>n</sup> − 1)</code>（r ＝ 年利 ÷ 12、n ＝ 返済回数）</p>
  <p>金利が同じでも返済期間を長くすると月々の負担は減りますが、利息の総額は増えます。逆に繰り上げ返済で期間を短縮すると利息を大きく減らせます。</p>

  <Faq items={faq} />
  <ToolCards exclude="loan" />
</BaseLayout>

<script>
  import { calcLoan } from '../../lib/loan';
  const $ = (id: string) => document.getElementById(id)!;
  const fmt = (n: number) => Math.round(n).toLocaleString('ja-JP');
  function render() {
    const p = Math.max(0, Number(($('principal') as HTMLInputElement).value) || 0) * 10000;
    const r = Math.max(0, Number(($('rate') as HTMLInputElement).value) || 0) / 100;
    const y = Math.max(1, Math.floor(Number(($('years') as HTMLInputElement).value) || 1));
    const inc = Math.max(0, Number(($('income') as HTMLInputElement).value) || 0) * 10000;
    const res = calcLoan({ principal: p, annualRate: r, years: y });
    $('l-monthly').textContent = fmt(res.monthlyPayment);
    $('l-total').textContent = fmt(res.totalPayment);
    $('l-interest').textContent = fmt(res.totalInterest);
    $('l-ep-first').textContent = fmt(res.firstPaymentEqualPrincipal);
    $('l-ep-last').textContent = fmt(res.lastPaymentEqualPrincipal);
    $('l-ep-interest').textContent = fmt(res.totalInterestEqualPrincipal);
    $('l-ratio-wrap').hidden = !inc;
    if (inc) $('l-ratio').textContent = ((res.monthlyPayment * 12 / inc) * 100).toFixed(1);
  }
  $('loan-form').addEventListener('input', render);
  $('loan-form').addEventListener('submit', (e) => e.preventDefault());
  render();
</script>
